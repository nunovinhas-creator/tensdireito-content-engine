# Configuração actualmente suportada para desenvolvimento local.
TDE_DB_PATH=data/tde.sqlite3

# Esquema reservado para D8; ainda não é lido pela aplicação.
# Não colocar credenciais reais neste ficheiro. Usar secrets/identidade de runtime.
# PostgreSQL gerido (fornecedor e formato da URL por decidir).
DATABASE_URL=
# Object storage compatível com S3 (S3/R2 por avaliar).
STORAGE_PROVIDER=
STORAGE_BUCKET_NAME=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PREFIX=daily/
